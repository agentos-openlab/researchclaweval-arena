{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "topics"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^(?!all$)[a-z0-9][a-z0-9_-]*$"},
    "name": {"type": "string", "minLength": 1},
    "topics": {"type": "object"}
  }
}
